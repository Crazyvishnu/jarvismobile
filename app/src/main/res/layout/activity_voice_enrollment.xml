<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101014">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔒 Voice Match Security"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Train Jarvis to recognize your unique vocal resonances &amp; pitch. Strangers &amp; family members will be ignored."
            android:textColor="#A0A0B0"
            android:textSize="14sp"
            android:textAlignment="center"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="20dp" />

        <!-- Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1A1A22"
            android:padding="20dp"
            android:layout_marginBottom="20dp"
            android:elevation="4dp">

            <TextView
                android:id="@+id/enrollmentStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Status: Not Enrolled"
                android:textColor="#FFAA00"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textAlignment="center" />

            <TextView
                android:id="@+id/instructionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Step 1 of 3: Tap Record and say your wake word clearly."
                android:textColor="#D0D0E0"
                android:textSize="15sp"
                android:textAlignment="center"
                android:layout_marginTop="12dp" />

            <!-- Sample indicators -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="center"
                android:layout_marginTop="16dp">

                <TextView
                    android:id="@+id/sample1Indicator"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="1"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#707080"
                    android:background="#252530"
                    android:gravity="center"
                    android:layout_marginEnd="16dp" />

                <TextView
                    android:id="@+id/sample2Indicator"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="2"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#707080"
                    android:background="#252530"
                    android:gravity="center"
                    android:layout_marginEnd="16dp" />

                <TextView
                    android:id="@+id/sample3Indicator"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="3"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#707080"
                    android:background="#252530"
                    android:gravity="center" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/recordSampleButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="🎙️ Tap to Record Sample 1"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#2D60FF"
            android:layout_marginBottom="16dp" />

        <!-- Testing & Tuning Card (Shown when enrolled) -->
        <LinearLayout
            android:id="@+id/testingCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1F2232"
            android:padding="16dp"
            android:layout_marginBottom="20dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🧪 Live Test &amp; Tune (Test vs Brother!)"
                android:textColor="#00E5FF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textAlignment="center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tap below and let your brother speak. If his score exceeds the limit, select a stricter setting!"
                android:textColor="#D0D0E0"
                android:textSize="13sp"
                android:textAlignment="center"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/testMatchButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="🎙️ Tap &amp; Speak to Test Match"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:backgroundTint="#8A2BE2" />

            <TextView
                android:id="@+id/testResultText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ready to test..."
                android:textColor="#A0A0A0"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAlignment="center"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Security Discrimination Limit:"
                android:textColor="#CCCCCC"
                android:textSize="13sp"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/threshNormalButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="Normal (60%)"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#333344"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/threshStrictButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="Strict (68%)"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#2B55FF"
                    android:layout_marginEnd="4dp"
                    android:layout_marginStart="4dp" />

                <Button
                    android:id="@+id/threshMaxButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="Max (75%)"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#333344"
                    android:layout_marginStart="4dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="4dp">

            <Button
                android:id="@+id/resetEnrollmentButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Reset &amp; Retrain"
                android:textColor="#D0D0E0"
                android:textSize="14sp"
                android:backgroundTint="#2E2E38"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/finishEnrollmentButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Done / Enable"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:backgroundTint="#1B9954"
                android:layout_marginStart="8dp"
                android:visibility="gone" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="24dp" />

        <Button
            android:id="@+id/skipButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Skip for now (Anyone can activate)"
            android:textColor="#808090"
            android:background="@android:color/transparent"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

    </LinearLayout>
</ScrollView>
