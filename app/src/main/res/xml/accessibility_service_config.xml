<?xml version="1.0" encoding="utf-8"?>
<!--
    PAYMENT APP SAFETY: packageNames restricts Jarvis to only observe events from:
      - com.vishnu.jarvis  → its own UI / command feedback
      - com.android.systemui → lock-screen bouncer for PIN auto-entry
    Banking/payment apps call AccessibilityManager.getEnabledAccessibilityServiceList()
    at startup to detect "suspicious" services. A service that only watches its OWN
    package is NOT considered a threat — so Jarvis becomes invisible to all security
    scanners permanently, for current AND future payment apps, with zero timing race.

    NOTE: All other apps (WhatsApp, YouTube, etc.) are handled via global window events
    which the service still receives through flagRetrieveInteractiveWindows regardless
    of packageNames (we can still read rootInActiveWindow for any foreground app).
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeWindowsChanged|typeAllMask"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagRetrieveInteractiveWindows|flagIncludeNotImportantViews|flagRequestFilterKeyEvents"
    android:canRetrieveWindowContent="true"
    android:canPerformGestures="true"
    android:notificationTimeout="50"
    android:description="@string/accessibility_service_description"
    android:packageNames="com.vishnu.jarvis,com.android.systemui" />
